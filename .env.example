# Copy to apps/web/.env.local (Next reads env from the app directory).

# Gemini model access for the analysis pipeline (server-side only).
GEMINI_API_KEY=

# Supabase project (Settings → API). The anon key is safe in the browser; RLS does the gating.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_, never send to the client.
# Used for cache-hit scans, audit rows, and account deletion.
SUPABASE_SERVICE_ROLE_KEY=

# Random string. Salts the IP hash stored in scan_audit (raw IPs are never stored).
AUDIT_IP_SALT=

# SERVER ONLY. 32 random bytes, base64 (openssl rand -base64 32). Encrypts users' own Gemini keys.
# The scanner needs the same value to decrypt them.
RED_SECRETS_KEY=

# Where apps/web reaches apps/scanner.
SCANNER_URL=http://localhost:4000

# Public origin: canonical URLs, sitemap, OpenGraph, and auth redirect URLs.
# Must be listed in Supabase → Auth → URL Configuration (Site URL / Redirect URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# apps/scanner (docker compose reads apps/scanner/.env; see apps/scanner/.env.example)
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://<ref>.supabase.co        (same project as above)
# SUPABASE_SERVICE_ROLE_KEY=                     (SERVER ONLY, same key as above)
# SCAN_CONCURRENCY=2                             (scans per scanner process)
# SCANNER_BOT_URL=https://<site>/bot             (goes in the User-Agent: REDScanner/1.0 (+URL))
