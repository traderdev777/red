# Copy to apps/scanner/.env for `docker compose up`. Never commit the real file.

# Supabase project (Settings -> API). Service role: SERVER ONLY, bypasses RLS.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# How many scans this process runs at once. Each scan is one Chrome (~300-500 MB).
SCAN_CONCURRENCY=2

# Public page that explains the scanner. Sent in every request's User-Agent:
#   REDScanner/1.0.0 (+https://your-site/bot)
SCANNER_BOT_URL=https://your-site.example/bot

# Optional
# SCAN_TIMEOUT_MS=60000       hard cap per scan
# SCAN_POLL_MS=2000           queue poll interval (Realtime also wakes the worker)
# REAPER_TIMEOUT_S=300        active scans older than this are failed + refunded
# SCANNER_LIGHTHOUSE=on       "off" skips Lighthouse (recorded as skipped)
# LOG_LEVEL=info
# Development sandboxes only, never production (weakens DNS pinning):
# SCANNER_UPSTREAM_PROXY=http://user:pass@proxy:port

# Analysis (optional). Without a key the scan still finishes with rule findings,
# and the report says the model was not configured.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TIMEOUT_MS=35000
# ANALYSIS_TIMEOUT_MS=45000
